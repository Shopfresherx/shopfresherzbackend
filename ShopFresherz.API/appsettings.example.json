{
  "ConnectionStrings": {
    "DefaultConnection": "REPLACE_WITH_DB_CONNECTION_STRING",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "ShopFresherz",
    "Audience": "ShopFresherz",
    "PrivateKeyPem": "REPLACE_WITH_RSA_PRIVATE_KEY_PEM",
    "PublicKeyPem": "REPLACE_WITH_RSA_PUBLIC_KEY_PEM",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Brevo": {
    "ApiKey": "REPLACE_WITH_BREVO_API_KEY",
    "FromEmail": "info@shopfresherz.com",
    "FromName": "ShopFresherz"
  },
  "BankTransfer": {
    "BankName": "Kuda Bank",
    "AccountNumber": "REPLACE_WITH_ACCOUNT_NUMBER",
    "AccountName": "REPLACE_WITH_ACCOUNT_NAME"
  },
  "GoogleAuth": {
    "ClientId": "REPLACE_WITH_GOOGLE_CLIENT_ID",
    "ClientSecret": "REPLACE_WITH_GOOGLE_CLIENT_SECRET"
  },
  "Termii": {
    "ApiKey": "REPLACE_WITH_TERMII_API_KEY",
    "SenderId": "ShopFresherz"
  },
  "Flutterwave": {
    "SecretKey": "REPLACE_WITH_FLUTTERWAVE_SECRET_KEY",
    "PublicKey": "REPLACE_WITH_FLUTTERWAVE_PUBLIC_KEY",
    "EncryptionKey": "REPLACE_WITH_FLUTTERWAVE_ENCRYPTION_KEY",
    "CallbackUrl": "https://shopfresherz.com/order/confirmed",
    "WebhookSecret": "REPLACE_WITH_WEBHOOK_SECRET"
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200",
    "ApiKey": ""
  },
  "Azure": {
    "BlobStorage": {
      "ConnectionString": "REPLACE_WITH_AZURE_BLOB_CONNECTION_STRING",
      "ContainerName": "shopfresherz-media",
      "CdnBaseUrl": ""
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000",
      "http://localhost:3001",
      "https://localhost:3001",
      "http://localhost:8080",
      "https://localhost:8080",
      "http://fresherz-001-site1.ftempurl.com",
      "https://fresherz-001-site1.ftempurl.com",
      "http://shopfresherz.com",
      "https://shopfresherz.com",
      "http://www.shopfresherz.com",
      "https://www.shopfresherz.com"
    ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/shopfresherz-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*"
}
